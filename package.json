{
    "name": "ddd-graphql-be",
    "version": "1.0.0",
    "description": "DDD + GraphQL (code-first) Node.js/TypeScript backend source base/boilerplate",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
        "dev:cluster": "nodemon --exec ts-node -r tsconfig-paths/register src/cluster.ts",
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "start": "node dist/server.js",
        "start:cluster": "node dist/cluster.js",
        "migration:generate": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:generate -d src/config/database.config.ts",
        "migration:run": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/config/database.config.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:revert -d src/config/database.config.ts",
        "test": "jest",
        "generate": "node scripts/generateModule.js",
        "create:module": "node scripts/generateModule.js"
    },
    "dependencies": {
        "@apollo/server": "^5.2.0",
        "@as-integrations/express4": "^1.1.2",
        "@aws-sdk/client-s3": "^3.958.0",
        "@aws-sdk/s3-request-presigner": "^3.958.0",
        "@types/nodemailer": "^8.0.0",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "cors": "^2.8.5",
        "cron-parser": "^5.5.0",
        "dataloader": "^2.2.3",
        "dotenv": "^16.3.1",
        "express": "^4.22.1",
        "express-rate-limit": "^7.1.5",
        "glob": "^10.3.10",
        "graphql": "^16.12.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.7",
        "pg": "^8.19.0",
        "redis": "^4.6.12",
        "reflect-metadata": "^0.1.14",
        "typeorm": "^0.3.19",
        "uuidv7": "^1.1.0",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/lodash": "^4.17.21",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.10.6",
        "@types/pg": "^8.16.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
