# ─────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL of this API (used in a few links/emails).
APP_URL=http://localhost:3000
# Display name used in emails etc. (no real value needed for local dev).
APP_NAME=App
# Optional logo URL used in outbound emails. Leave empty to omit.
APP_LOGO_URL=
GRAPHQL_PATH=/graphql
# Set to "true" to enable the GraphQL landing page / introspection outside dev.
ENABLE_GRAPHQL_INTROSPECTION=false
# Comma-separated allowlist of frontend origins allowed to make credentialed requests,
# e.g. https://app.example.com,https://admin.example.com
# REQUIRED in production — without it, CORS falls back to reflecting any Origin header,
# which combined with credentials:true lets any website use a logged-in user's session.
CORS_ORIGINS=http://localhost:4321
# Max GraphQL query selection-set nesting depth. Guards against deeply nested/DoS
# queries; raise if legitimate queries with deep fragment nesting start failing.
GRAPHQL_MAX_DEPTH=15
# Max time (ms) a single request may take before the server responds 503 and gives up
# waiting on it. Also caps how long a single Postgres statement may run (see database.config.ts).
REQUEST_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
WEB_CONCURRENCY=1

# ─────────────────────────────────────────────────────────────────
# Database (all REQUIRED — the app throws at startup if any are missing)
# ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_db
# "true" to enable TLS to the DB (e.g. managed Postgres providers).
DB_SSL=false
# PostgreSQL session timezone (IANA name, e.g. UTC, Asia/Ho_Chi_Minh). Default: UTC.
DB_TIMEZONE=UTC
# "true" to allow TypeORM synchronize() to run outside NODE_ENV=development
# (used for bootstrapping a brand-new restricted/NODE instance — see
# src/config/instance.config.ts). Leave unset/false in normal production.
DB_SYNCHRONIZE=false
# TEST-ONLY escape hatch to skip running migrations. Only takes effect when
# NODE_ENV=test — ignored otherwise, so it can never skip migrations in prod.
DB_SKIP_MIGRATIONS=false

# ─────────────────────────────────────────────────────────────────
# Redis cache (optional — cacheManager runs in no-op/in-memory mode if unset)
# ─────────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────
# Auth / secrets (REQUIRED — no insecure defaults; generate strong random values)
# ─────────────────────────────────────────────────────────────────
# e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Used by src/core/shared/utils/crypto.util.ts (AES-256 field-level encryption
# helper). Only required if/when you actually call encrypt()/decrypt().
ENCRYPTION_SECRET=

# ─────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────
# Global limiter (see server.ts registerRateLimit).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# ─────────────────────────────────────────────────────────────────
# Media / S3-compatible storage (used by the `media` module)
# ─────────────────────────────────────────────────────────────────
# Full URL encoding bucket + credentials + optional custom endpoint, e.g.:
#   https://<accessKeyId>:<secretAccessKey>@<bucket>.s3.amazonaws.com/<folder>?region=ap-southeast-1
#   (add &endpoint=<url> for S3-compatible providers like MinIO/R2/Spaces)
S3_URL=
CDN_DOMAIN=
UPLOAD_MAX_MB=50

# ─────────────────────────────────────────────────────────────────
# Multi-instance deployment role (optional — see src/config/instance.config.ts)
# ─────────────────────────────────────────────────────────────────
# CENTRAL (default) | NODE — a minimal example pattern for running this
# codebase as a full instance vs. a restricted per-tenant instance. Most
# projects can leave this unset.
INSTANCE_ROLE=CENTRAL
LOCKED_AGENCY_ID=

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
